{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Genaicode",
  "mainBinaryName": "genaicode",
  "version": "0.1.0",
  "identifier": "pl.tanczyk.grzegorz.genaicode",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Genaicode",
        "width": 1100,
        "height": 800,
        "minWidth": 480,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 26 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5QzU4NDcwQUQwNzVFNUIKUldSYlhnZXRjSVRGYVhaRVJnbDJEVDNZdlRLMHNiRVZHMGZDWERNTFprWXFIcDlkWkhxNC9PVG4K",
      "endpoints": ["https://github.com/gtanczyk/genaicode/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/node"],
    "resources": {
      "runtime/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "13.5",
      "entitlements": "Entitlements.plist"
    }
  }
}
